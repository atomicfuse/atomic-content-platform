---
/** Grid template footer: copyright + legal links. */
import type { ResolvedConfig } from '@atomic-platform/shared-types';
import { safePrivacyUrl } from '../../../lib/consent-scripts';

interface Props {
  config: ResolvedConfig;
}
const { config } = Astro.props;
const year = new Date().getUTCFullYear();
const links = [
  ['About', '/about'],
  ['Contact', '/contact'],
  ['Privacy Policy', '/privacy'],
  ['Terms of Service', '/terms'],
] as const;
---

<footer class="g-footer">
  <div class="g-footer__inner">
    <p class="g-footer__text">&copy; {year} {config.site_name}. All rights reserved.</p>
    <nav class="g-footer__links" aria-label="Legal">
      {links.map(([label, href]) => (
        <a class="g-footer__link" href={href}>{label}</a>
      ))}
      {config.consent?.enabled && (
        <a class="g-footer__link" href={safePrivacyUrl(config.consent.privacy_url)} data-atl-consent-open>Cookie settings</a>
      )}
    </nav>
  </div>
</footer>
