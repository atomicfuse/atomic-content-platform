---
import AdSlot from '../../../components/AdSlot.astro';
import NewsletterBox from './NewsletterBox.astro';
import FollowUs from './FollowUs.astro';
import CategoryList from './CategoryList.astro';
import type { ResolvedConfig } from '@atomic-platform/shared-types';
import type { ArticleIndexEntry } from '../../../lib/kv-schema';

interface Props {
  variant: 'home' | 'article';
  config: ResolvedConfig;
  categories?: { topic: string; articles: ArticleIndexEntry[] }[];
  latestArticles?: ArticleIndexEntry[];
}
const { config, variant, categories = [], latestArticles = [] } = Astro.props;
---

<aside class="sidebar">
  <div class="sidebar-sticky">
    {variant === 'home' && (
      <>
        <AdSlot position="sidebar" pageType="homepage" server:defer />
        {latestArticles.length > 0 && (
          <section class="sidebar-more">
            <h3 class="sidebar-more-heading">More</h3>
            <ul class="sidebar-more-list">
              {latestArticles.map((article) => (
                <li>
                  <a href={`/${article.slug}`} class="sidebar-more-link">
                    {article.featuredImage && (
                      <img src={article.featuredImage} alt="" loading="lazy" />
                    )}
                    <span>{article.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <NewsletterBox domain={config.domain} />
      </>
    )}
    {variant === 'article' && (
      <>
        <AdSlot position="sidebar" pageType="article" server:defer />
        <FollowUs />
        {categories.map((c) => (
          <CategoryList topic={c.topic} articles={c.articles} />
        ))}
      </>
    )}
  </div>
</aside>

<style>
  .sidebar { /* grid item — stretches to full cell height by default */ }
  .sidebar-sticky {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  @media (min-width: 960px) {
    .sidebar-sticky {
      position: sticky;
      top: calc(64px + 1rem);
    }
  }

  /* "More" section */
  .sidebar-more-heading {
    background: var(--color-primary, #1a1a2e);
    color: var(--color-category_header_text, #fff);
    text-align: center;
    padding: 0.75rem;
    margin: 0 0 1rem;
    font-size: var(--text-base, 1rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    border-radius: var(--radius-sm, 4px);
  }
  .sidebar-more-list { list-style: none; padding: 0; margin: 0; }
  .sidebar-more-list li { margin-bottom: 0.75rem; }
  .sidebar-more-link {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0.75rem;
    color: inherit; text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .sidebar-more-link:hover span { color: var(--color-accent); }
  .sidebar-more-link img {
    width: 100%; aspect-ratio: 1; object-fit: cover;
    border-radius: var(--radius-sm, 4px);
  }
</style>
