# Google OAuth (NextAuth)
GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxx
NEXTAUTH_SECRET=your-random-secret-here

# GitHub API token with repo access to network repos
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# Cloudflare (domain management, KV operations)
CLOUDFLARE_API_TOKEN=cfut_xxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxx

# Gemini API key for logo generation
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxx

# Email Subscriber Collection (Google Sheets)
GOOGLE_SHEET_ID=xxxxxxxxxxxxx
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# --- Local dev only (not needed in CloudGrid) ---
# NEXTAUTH_URL=http://localhost:3000
# CONTENT_AGENT_URL=http://localhost:5000
# LOCAL_NETWORK_PATH=/path/to/atomic-labs-network
