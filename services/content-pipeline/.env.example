# GitHub API token with repo access to network repos
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# Anthropic API key for Claude (not needed in CloudGrid — AI Gateway handles it)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Gemini API key for image generation (optional — skips featuredImage if absent)
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxx

# OpenAI API key (optional)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx

# Network repo (org/repo format) — set in cloudgrid.yaml env
# NETWORK_REPO=atomicfuse/atomic-labs-network

# --- Local dev only (not needed in CloudGrid) ---
# LOCAL_NETWORK_PATH=/path/to/atomic-labs-network
# CONTENT_AGGREGATOR_URL=https://content-aggregator-cloudgrid.apps.cloudgrid.io
# CONTENT_API_BASE_URL=https://content-aggregator-cloudgrid.atomic.cloudgrid.io/api
# PORT=5000
# REDIS_URL is auto-injected by `requires: redis: private` in cloudgrid.yaml
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=
